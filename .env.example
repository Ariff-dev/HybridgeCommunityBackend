# Database Configuration
# IMPORTANT: DB_HOST value depends on how you run the project:
# - Use 'mariadb' when running with Docker (docker-compose up)
# - Use 'localhost' or '127.0.0.1' when running PHP natively
DB_HOST=mariadb
DB_USER=hybridge_user
DB_PASS=your_secure_password
DB_NAME=hybridge_community
DB_ROOT_PASSWORD=root_secure_password

# JWT Configuration
# Generate a secure secret with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# API Configuration
API_DEBUG=true
